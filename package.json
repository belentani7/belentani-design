{
  "name": "belentani-design",
  "version": "1.1.0",
  "private": true,
  "description": "Sistema de diseno unico del estate belentani7: tokens, temas y componentes sin build.",
  "license": "MIT",
  "type": "module",
  "engines": {
    "node": ">=22.22.0"
  },
  "scripts": {
    "test": "node --test \"tests/*.test.mjs\"",
    "check": "node scripts/check-design.mjs",
    "html": "node scripts/check-design.mjs --only html",
    "audit": "node scripts/audit.mjs",
    "lighthouse": "node scripts/lighthouse-summary.mjs",
    "tokens": "node scripts/build-tokens.mjs",
    "tokens:check": "node scripts/build-tokens.mjs --check",
    "serve": "node scripts/serve.mjs",
    "verify": "npm run tokens:check && npm run check && npm test"
  },
  "devDependencies": {
    "html-validate": "^11.22.1"
  }
}
